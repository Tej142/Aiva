# ============================================================
# AIVA Server Configuration & Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control!
# ============================================================

# --- Brevo Transactional Email (Required for OTP Authentication) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=AIVA Assistant

# --- Security & JWT Settings ---
JWT_SECRET=generate_a_random_64_character_hex_secret_here
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=30

# --- Server Host & Port ---
AIVA_HOST=0.0.0.0
AIVA_PORT=5000

# --- LLM API Keys (Also supported in config/secrets.json) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

