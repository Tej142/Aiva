# ============================================================
# AIVA Server Configuration & Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control!
# ============================================================

# --- Brevo Transactional Email (Required for OTP Authentication) ---
# NOTE: BREVO_SENDER_EMAIL must match a validated sender in your Brevo account (Senders & IP -> Senders)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=AIVA Assistant

# --- Security & JWT Settings ---
JWT_SECRET=generate_a_random_64_character_hex_secret_here
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=30

# --- Server Host & Port ---
AIVA_HOST=0.0.0.0
AIVA_PORT=5000

# --- LLM API Keys (Also supported in config/secrets.json) ---
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- WhatsApp Channel & Multi-User RBAC ---
# Security: Lock permissions on VM after editing: `chmod 600 .env` (never commit .env!)
# Quoted values support spaces (e.g. AIVA_ACCESS_PASSWORD="my team secret!").
# Edits to .env hot-reload automatically via mtime check (no server restart needed).
WHATSAPP_ENABLED=true

# Dedicated phone number paired with the Baileys bridge (digits only with country code)
# The bridge refuses to run if paired with any different number.
AIVA_WHATSAPP_NUMBER=919876543210

# Email of the sole AIVA Admin account (exempt from WhatsApp credential challenge)
AIVA_ADMIN_EMAIL=charanpc1420091@gmail.com

# Local Baileys Bridge IPC (127.0.0.1 only)
WHATSAPP_BRIDGE_PORT=3001
WHATSAPP_BRIDGE_SECRET=generate_a_random_64_character_secret_here
WHATSAPP_BACKEND_URL=http://127.0.0.1:5000

# Shared Access Credentials (deterministic challenge, never reaches LLM/logs/DB)
# Optional AIVA_ACCESS_PASSWORD_HASH (pbkdf2:sha256:iters$salt$hex) takes precedence if set.
# Bump AIVA_ACCESS_EPOCH to invalidate active non-admin access and force immediate re-auth.
AIVA_ACCESS_USERNAME="team_user"
AIVA_ACCESS_PASSWORD="change_this_shared_password"
AIVA_ACCESS_PASSWORD_HASH=
AIVA_ACCESS_EPOCH=1
AIVA_ACCESS_MAX_ATTEMPTS=3
AIVA_ACCESS_LOCK_MINUTES=30
AIVA_ACCESS_CHALLENGE_TTL_MINUTES=5
AIVA_ACCESS_MAX_CHALLENGES_PER_HOUR=20
AIVA_REQUIRE_OWNER_APPROVAL=false

# Entry B Verification ('inbound' default: user clicks wa.me deep link; 'outbound' sends code to user)
WHATSAPP_VERIFY_MODE=inbound
WHATSAPP_MAX_VERIFY_SENDS_PER_DAY=3

# Per-User Limits & Capabilities
AIVA_USER_DAILY_MESSAGE_CAP=100
AIVA_USER_CAN_SEND_WHATSAPP=false
WHATSAPP_ALLOW_POWER_CONTROL=false

# Session Lifecycle & Reply Windows
WHATSAPP_START_TRIGGER="aiva\\"
WHATSAPP_STOP_TRIGGER="stop\\"
WHATSAPP_SESSION_IDLE_MINUTES=60
WHATSAPP_REPLY_WINDOW_MINUTES=10

# Outbound Notifications, Quiet Hours & Third-Party Inbox
WHATSAPP_QUIET_HOURS_START=23:00
WHATSAPP_QUIET_HOURS_END=07:00
WHATSAPP_REPLY_DELAY_MS=700
WHATSAPP_MAX_OUTBOUND_PER_HOUR=20
WHATSAPP_MAX_MESSAGE_CHARS=1500
WHATSAPP_INBOX_RETENTION_DAYS=7
WHATSAPP_MARK_READ_ON_READ=true
WHATSAPP_UNKNOWN_SENDER_USER_EMAIL=

